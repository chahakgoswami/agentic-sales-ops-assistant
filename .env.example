# ─────────────────────────────────────────────
# Agentic Sales Ops Assistant — environment config
# Copy this file to .env and fill in your values.
# ─────────────────────────────────────────────

# Logging level: DEBUG | INFO | WARNING | ERROR
SALES_OPS_LOG_LEVEL=INFO

# Path to write the forecast JSON file
SALES_OPS_FORECAST_PATH=forecast_report.json

# Whether to auto-confirm HITL prompts (true/false)
# Set to true for headless / CI runs
SALES_OPS_AUTO_CONFIRM=false

# IMAP seed for reproducible mock inbox results
# Leave blank for non-deterministic behaviour
SALES_OPS_IMAP_SEED=42

# Max pipeline loops per orchestrator run
SALES_OPS_MAX_PIPELINE_LOOPS=1

# Delay in seconds between pipeline loops (0 = no delay)
SALES_OPS_LOOP_DELAY_SECONDS=0.0
